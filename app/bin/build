#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# Qt 6.9 is the oldest Qt the app supports (Omarchy stable ships 6.11, edge
# 6.12); an older qmake6 would build against API the release never sees.
qt_version=$(qmake6 -query QT_VERSION)
qt_major=${qt_version%%.*}
qt_minor=${qt_version#*.}
qt_minor=${qt_minor%%.*}
if [ "$qt_major" -lt 6 ] || { [ "$qt_major" -eq 6 ] && [ "$qt_minor" -lt 9 ]; }; then
    printf 'Qt 6.9 or newer is required; qmake6 reports Qt %s.\n' "$qt_version" >&2
    exit 1
fi

mkdir -p "$ROOT/build"
cd "$ROOT/build"

qmake6 "$ROOT/seldon-desk.pro"
# Capped at 8 jobs: the dev host runs other gates beside this one.
make -j8

echo "Built $ROOT/build/seldon-desk"
