# Maintainer: JohnAndrewsX <e.andres+aur@ik.me>
#
# The app-era package (WP-230, E96): `seldon` is the engine, the Seldon window
# (seldon-desk, C++ and Qt Quick) and the bar plugin in one package. It sits
# beside packaging/PKGBUILD (`jax-seldon`, the engine alone); only a release
# from 0.5.0 on builds this one (packaging/README.md, "The seldon package").
# The recipe for omarchy-pkgs is a copy of this file (packaging/opr/).
#
# The engine is a glibc build, not musl (ADR-0022); the desk binary is
# compiled by the app's own bin/build (qmake6 and make).

pkgname=seldon
pkgver=0.5.0
pkgrel=1
pkgdesc='The memory of your Omarchy machine: logbook, engine and window'
arch=('x86_64')
url='https://github.com/JohnAndrewsX/jax-seldon'
license=('MIT')
depends=(
  'gcc-libs'
  'git>=2.44'
  'glibc'
  'hicolor-icon-theme'
  'qt6-base>=6.9'
  'qt6-declarative>=6.9'
  'qt6-svg'
  'qt6-wayland'
)
makedepends=('cargo' 'gcc' 'make')
optdepends=('snapper: snapshot events (needs read access to /.snapshots)')
provides=('jax-seldon')
conflicts=('jax-seldon')
replaces=('jax-seldon')
install='seldon.install'
# Cargo's release profile strips the engine; a debug package would be empty
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

# the repository's name, not the package's, names the tarball's folder
_dir="jax-seldon-$pkgver"

prepare() {
  cd "$_dir/engine"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_dir/engine"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --features watch

  cd "../app"
  ./bin/build
}

check() {
  cd "$_dir/engine"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
  export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
  # unit tests only, in a scratch home away from the builder's
  # ~/.config/seldon and ~/.local/state/seldon (docs/TESTING.md); the
  # integration tests and the app's tests stay in CI
  local scratch="$srcdir/test-home"
  mkdir -p "$scratch/home"
  HOME="$scratch/home" XDG_CONFIG_HOME="$scratch/config" \
    XDG_STATE_HOME="$scratch/state" XDG_DATA_HOME="$scratch/data" \
    SELDON_TEST_GUARD="$scratch" \
    cargo test --frozen --features watch --lib --bins
}

package() {
  cd "$_dir"
  install -Dm755 engine/target/release/seldon "$pkgdir/usr/bin/seldon"
  ln -s seldon "$pkgdir/usr/bin/jax-seldon"
  # the window: GUI only, started by `seldon open`
  install -Dm755 app/build/seldon-desk "$pkgdir/usr/lib/seldon/seldon-desk"

  # the optional watcher unit (ADR-0005): installed, never enabled
  install -dm755 "$pkgdir/usr/lib/systemd/user"
  sed 's|%h/\.local/bin/seldon|/usr/bin/seldon|; s|~/\.local/bin/seldon|/usr/bin/seldon|' \
    engine/systemd/seldon-watch.service \
    > "$pkgdir/usr/lib/systemd/user/seldon-watch.service"
  chmod 644 "$pkgdir/usr/lib/systemd/user/seldon-watch.service"
  grep -qx 'ExecStart=/usr/bin/seldon watch' "$pkgdir/usr/lib/systemd/user/seldon-watch.service"

  # the man page and the shell completions, generated by the binary just
  # built from its own clap definition (WP-049); makepkg gzips the man page
  local bin=engine/target/release/seldon
  install -dm755 "$pkgdir/usr/share/man/man1" \
    "$pkgdir/usr/share/bash-completion/completions" \
    "$pkgdir/usr/share/zsh/site-functions" \
    "$pkgdir/usr/share/fish/vendor_completions.d"
  "$bin" mangen > "$pkgdir/usr/share/man/man1/seldon.1"
  "$bin" completions bash > "$pkgdir/usr/share/bash-completion/completions/seldon"
  "$bin" completions zsh > "$pkgdir/usr/share/zsh/site-functions/_seldon"
  "$bin" completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/seldon.fish"
  chmod 644 "$pkgdir/usr/share/man/man1/seldon.1" \
    "$pkgdir/usr/share/bash-completion/completions/seldon" \
    "$pkgdir/usr/share/zsh/site-functions/_seldon" \
    "$pkgdir/usr/share/fish/vendor_completions.d/seldon.fish"

  install -Dm644 packaging/seldon/seldon.desktop "$pkgdir/usr/share/applications/seldon.desktop"
  install -Dm644 packaging/seldon/seldon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/seldon.svg"

  # the bar plugin's copy: `seldon` installs it into the user's plugin
  # folder; the package never writes to a home directory
  local f
  while IFS= read -r -d '' f; do
    install -Dm644 "plugin/$f" "$pkgdir/usr/share/seldon/plugin/$f"
  done < <(cd plugin && find . -type f -printf '%P\0' | LC_ALL=C sort -z)

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
