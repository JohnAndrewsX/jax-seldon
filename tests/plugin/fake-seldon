#!/usr/bin/env bash
# Fake `seldon` for the plugin harnesses (tests/plugin/service-states.sh,
# desk-view.sh). Speaks just enough of the CLI (SPEC-ENGINE §3) for the
# plugin: --version, capture, status, log, open, plan new|start|verify|done|drop,
# drift link|explain|dismiss|show, decide, agent start.
# Every call is logged to $HOME/calls.log as "start <cmd>" / "end <cmd>" so
# the test can prove calls never overlap, and its exact argv to
# $HOME/argv.log, one line per call, each argument `printf %q`-quoted (a
# newline shows as $'…\n…'), so the test can compare argument by argument.
#
#   FAKE_SELDON_MODE     ok (default) | uninit; $HOME/mode overrides it, so a
#                        test can run `seldon init` halfway through
#   FAKE_SELDON_FIXTURE  index written by `status` in mode ok to
#                        ${XDG_STATE_HOME:-$HOME/.local/state}/seldon/index.json;
#                        generatedAt is replaced with the current time
#   FAKE_SELDON_FIXTURE_AFTER  if set, `status` writes this index instead
#                        once `capture` has run twice (the user's
#                        "Capture now" after the start-up capture)
#   FAKE_SELDON_WRITTEN  what `capture --json` reports as written (default 0)
#   FAKE_SELDON_LOCKED   if set, every `plan`, resolving `drift`, `decide` and
#                        `agent` call exits 4 (lock held)
#   FAKE_SELDON_CAPTURE_LOCKED  N: the first N `capture` calls exit 4 (lock
#                        held, the engine's JSON error), counted in
#                        $HOME/locked-captures (WP-068)
#   FAKE_SELDON_CAPTURE_EXIT  if set, every `capture` exits with this code,
#                        writes FAKE_SELDON_CAPTURE_STDERR (default two
#                        lines; set and empty: nothing) to stderr and
#                        FAKE_SELDON_CAPTURE_STDOUT (default nothing) to
#                        stdout (WP-068, WP-078)
#   FAKE_SELDON_CAPTURE_EXIT_CALLS  if set, FAKE_SELDON_CAPTURE_EXIT applies
#                        only to these `capture` calls (comma list, 1-based,
#                        every call counted in $HOME/capture-calls) (WP-085)
#   FAKE_SELDON_CAPTURE_WARNINGS  a JSON list of strings that a successful
#                        `capture --json` reports as `warnings` (default [])
#   FAKE_SELDON_CAPTURE_WARNED  if set, only these `capture` calls report the
#                        warnings (comma list, as _EXIT_CALLS); the others
#                        report [] (WP-085)
#   FAKE_SELDON_UNKNOWN_CASE  the case id `log`, `open`, `plan` and `agent`
#                        do not know (default C-2026-999): exit 1, "unknown case <id>"
#   FAKE_SELDON_NO_LAUNCHER  if set, `agent start` answers as the engine does
#                        without `omarchy` on PATH (exit 1)
#   FAKE_SELDON_NO_DEFAULT_AGENT  if set, `agent start --new` answers as the
#                        engine does without an Omarchy default agent (exit 1,
#                        nothing created) (WP-101)
#   FAKE_SELDON_RULES    the rules row `doctor --json` reports: current
#                        (default) | outdated | damaged; $HOME/rules overrides
#                        it, and `rules update` writes "current" there (WP-101);
#                        $HOME/rules-fail makes `rules update` refuse with its
#                        text (WP-111)
#
# `plan` treats the index the fake last wrote (the state index) as its
# logbook: a case's status is the one the index lists, unless $HOME/cases
# has a line "<id> <status>" for it (a logbook the index has not caught up
# with). A step follows the engine's transition rules and refuses with the
# engine's message; an allowed step, and `plan new`, rewrite the state index
# atomically with the case in its new column, as the real engine's index
# rebuild does. Needs jq.
#
# `drift link|explain|dismiss` (WP-021) work on the same state index: the
# engine's checks and messages (a link's case first, then the event), the
# selection (a group's open members, or the named event with --only), the
# fold (resolution, resolutionDetail, case; ADR-0021 for explain), the item
# dropped or re-keyed to a new leader after --only, the summary recounted,
# and `explain`'s retroactive completed case. A re-run on a resolved event,
# or on an event $HOME/resolved lists as "<id> <resolution> [<case>]" (a
# logbook the index has not caught up with), is the engine's no-op:
# resolved 0 and `already`. `drift show` lists the open members, plus those
# in $HOME/extra-events.json (members the capped index no longer lists).
#
# `decide` (WP-023) adds the next ADR, status proposed, to the state index's
# decisions (newest first, as the engine lists them) and answers in the
# SPEC-ENGINE §3 shape; it writes no ledger event, like the engine. `open
# ADR-NNNN` opens the path the state index lists for it; `open logbook` the
# logbook folder.
#
# `agent start <id>` (WP-022) checks the case like the engine (status from
# the state index or $HOME/cases: active only, queued gets the `seldon plan
# start` hint), launches nothing, and answers with the engine's JSON for
# the default launcher; it writes the id to $HOME/active-case.
#
# `agent start --new -- <intent>` (WP-101) creates and starts a case in the
# state index (title: the text up to its first ". ", at most 72 characters)
# and answers like `agent start` plus `created`. `plan reopen <id>` (a
# completed case only) adds an active "Reopen: <title>" case with the tag
# `reopens:<id>` and answers with `reopens` and `earlier`; it takes
# $HOME/active-case only when that names no open case (else `kept`). `doctor --json`
# reports one `rules` row and is logged to $HOME/doctor.log only (it runs in
# its own process, beside the queue, so it is kept out of calls.log and
# argv.log); `rules update --json` sets the rules current.
#
# `log` and `open` answer in the SPEC-ENGINE §3 JSON shapes. `open … --editor` hands the path to
# `omarchy-launch-editor` as the real engine does without a terminal; the
# harness puts a recorder there.
set -euo pipefail

log="$HOME/calls.log"
cmd="${1:-}"
mode=${FAKE_SELDON_MODE:-ok}
unknown=${FAKE_SELDON_UNKNOWN_CASE:-C-2026-999}
[[ -f $HOME/mode ]] && mode=$(<"$HOME/mode")
if [[ $cmd == doctor ]]; then
  printf '%s\n' "$(printf '%q ' "$@")" >>"$HOME/doctor.log"
  rules=${FAKE_SELDON_RULES:-current}
  [[ -f $HOME/rules ]] && rules=$(<"$HOME/rules")
  case $rules in
    outdated) row='{"name":"rules","status":"degraded","message":"outdated (v1)","fix":"seldon rules update (archives your copy)"}' ;;
    damaged) row='{"name":"rules","status":"error","message":"damaged (the block has no end marker)","fix":"seldon rules update --replace (archives the file)"}' ;;
    *) row='{"name":"rules","status":"ok","message":"current (v3)"}' ;;
  esac
  echo "{\"checks\":[{\"name\":\"engine\",\"status\":\"ok\",\"message\":\"seldon 0.1.0-fake\"},$row]}"
  [[ $rules == damaged ]] && exit 1
  exit 0
fi
printf '%s\n' "$(printf '%q ' "$@")" >>"$HOME/argv.log"
echo "start $cmd" >>"$log"
trap 'echo "end $cmd" >>"$log"' EXIT

uninit() {
  echo '{"error":{"code":3,"message":"logbook not initialised"}}'
  exit 3
}

user_error() {
  echo "{\"error\":{\"code\":1,\"message\":\"$1\"}}"
  exit 1
}

state_index() {
  local state=${XDG_STATE_HOME:-}
  [[ $state == /* ]] || state="$HOME/.local/state"
  echo "$state/seldon/index.json"
}

# Rewrite the state index with jq filter $1 (further jq arguments follow),
# temp file + rename like the engine. No index, nothing to rewrite.
rewrite_index() {
  local index filter=$1
  shift
  index=$(state_index)
  [[ -f $index ]] || return 0
  jq --arg now "$(date --iso-8601=seconds)" "$@" "$filter | .generatedAt = \$now" "$index" >"$index.tmp"
  mv "$index.tmp" "$index"
}

case_status() { # case_status <id> — the logbook's status, empty when unknown
  local line index
  if [[ -f $HOME/cases ]] && line=$(grep -m 1 "^$1 " "$HOME/cases"); then
    echo "${line#* }"
    return
  fi
  index=$(state_index)
  [[ -f $index ]] && jq -r --arg id "$1" '[.cases[][] | select(.id == $id) | .status][0] // empty' "$index"
  return 0
}

set_status() { # set_status <id> <status>
  if [[ -f $HOME/cases ]]; then
    grep -v "^$1 " "$HOME/cases" >"$HOME/cases.tmp" || true
    mv "$HOME/cases.tmp" "$HOME/cases"
  fi
  echo "$1 $2" >>"$HOME/cases"
}

folder() {
  case $1 in
    queued) echo queued ;;
    active | verification) echo active ;;
    *) echo completed ;;
  esac
}

# The index columns: verification has its own, dropped goes with completed
# (newest closed first). Counts follow the columns.
MOVE_CASE='def column($s): if $s == "dropped" then "completed" else $s end;
  ([.cases[][] | select(.id == $id)][0]) as $c
  | if $c == null then . else
      (.cases |= with_entries(.value |= map(select(.id != $id))))
      | ($c + {status: $to, path: ("work/" + $folder + "/" + ($c.path // ($id + ".md") | split("/") | last))}
          + (if $to == "active" then {started: $today} else {} end)
          + (if $to == "completed" or $to == "dropped" then {closed: $today} else {} end)) as $n
      | if column($to) == "completed" then .cases.completed = [$n] + .cases.completed
        else .cases[column($to)] += [$n] end
      | .summary.activeCases = (.cases.active | length)
      | .summary.queuedCases = (.cases.queued | length)
    end'

plan_new() {
  local zone=yellow risk=R1 priority=normal area="" title id index next
  while (($# > 0)) && [[ $1 != -- ]]; do
    case $1 in
      --zone) zone=$2; shift ;;
      --risk) risk=$2; shift ;;
      --area) area=$2; shift ;;
      --priority) priority=$2; shift ;;
    esac
    shift
  done
  title=${2:-}
  [[ -n ${title//[[:space:]]/} ]] || user_error "the title must not be empty"
  [[ $title != *$'\n'* ]] || user_error "the title must be one line"
  next=9
  index=$(state_index)
  [[ -f $index ]] && next=$(jq '[.cases[][] | .id | capture("^C-2026-(?<n>[0-9]+)$").n | tonumber] | (max // 0) + 1' "$index")
  id=$(printf 'C-2026-%03d' "$next")
  set_status "$id" queued
  rewrite_index '.cases.queued += [{id: $id, title: $title, status: "queued", zone: $zone, risk: $risk, priority: $priority}
      + (if $area == "" then {} else {area: $area} end)
      + {created: "2026-10-01", started: null, closed: null, snapshotBefore: null, agents: [], events: [], tags: [],
         path: ("work/queued/" + $id + "-case.md"), steps: {total: 0, done: 0}}]
    | .summary.queuedCases = (.cases.queued | length)' \
    --arg id "$id" --arg title "$title" --arg zone "$zone" --arg risk "$risk" --arg priority "$priority" --arg area "$area"
  jq -cn --arg id "$id" --arg title "$title" --arg zone "$zone" --arg risk "$risk" --arg area "$area" '{
    case: {id: $id, title: $title, status: "queued", zone: $zone, risk: $risk, path: ("work/queued/" + $id + "-case.md")},
    event: {id: "01M3W1FAKE0000000000000CAS", source: "seldon", kind: "case-created", subject: $id, detail: $title, case: $id},
    areaCreated: (if $area == "" then null else $area end),
    git: {committed: true, message: ($id + " created")}}'
}

plan_step() { # plan_step <start|verify|done|drop> <id>
  local step=$1 id=$2 from allowed to hint="" moved=""
  [[ $id == "$unknown" ]] && user_error "unknown case $id"
  from=$(case_status "$id")
  [[ -n $from ]] || user_error "unknown case $id"
  case $step in
    start) allowed="queued"; to=active ;;
    verify) allowed="active"; to=verification ;;
    done) allowed="verification"; to=completed ;;
    drop) allowed="queued active verification"; to=dropped ;;
  esac
  if [[ " $allowed " != *" $from "* ]]; then
    [[ $step == done && $from == active ]] && hint='; run `seldon plan verify` first'
    [[ $step == verify && $from == queued ]] && hint='; run `seldon plan start` first'
    user_error "$id is $from; \`seldon plan $step\` needs a case that is ${allowed// /, }$hint"
  fi
  set_status "$id" "$to"
  [[ $(folder "$from") != "$(folder "$to")" ]] && moved="work/$(folder "$from")/$id.md"
  rewrite_index "$MOVE_CASE" --arg id "$id" --arg to "$to" --arg folder "$(folder "$to")" --arg today 2026-10-01
  jq -cn --arg id "$id" --arg step "$step" --arg from "$from" --arg to "$to" --arg moved "$moved" '{
    case: {id: $id, status: $to},
    from: $from, to: $to,
    movedFrom: (if $moved == "" then null else $moved end),
    activeCase: (if $step == "start" then {set: $id} elif $step == "verify" then null else {cleared: true} end),
    journal: (if $to == "completed" then "journal/2026/2026-10-01.md" else null end),
    event: {id: "01M3W1FAKE0000000000000STP", source: "seldon", kind: ({start: "case-started", verify: "case-verified", done: "case-completed", drop: "case-dropped"}[$step]), subject: $id, case: $id},
    git: {committed: true, message: ($id + " " + $to)}}'
}

# ---- drift (SPEC-ENGINE §3, §5; WP-008 handover) ----------------------------

# The open drift events of the state index: every item's own event, and the
# caseless, unresolved members of a group item (ADR-0013).
DRIFT_DEFS='def items: (.drift // []);
  def groups: [items[] | select(.members != null and .txId != null) | .txId];
  def open_ids: ([items[] | .eventId] + [groups as $g | .events[]
      | select(.txId != null and (.txId as $t | $g | index($t)) and .case == null and .resolution == null) | .id]) | unique;
  def event($id): [.events[] | select(.id == $id)][0];'

# What a resolving call on $id resolves: nothing when the event is not open,
# itself with --only or when it is no group member, else every open member of
# its transaction, oldest first.
DRIFT_SELECT='open_ids as $open | event($id) as $e
  | if ($open | index($id)) == null then []
    elif $only or ($e.source != "pacman") or ($e.txId == null) or ((groups | index($e.txId)) == null) then [$e]
    else [.events[] | select(.id as $i | $open | index($i)) | select(.txId == $e.txId)] | sort_by(.ts, .id) end'

# Fold the resolution onto the selected events, drop their items, re-key a
# group that keeps open members (new leader: lowest-id explicit member, else
# lowest id; `members` only from 2 on), and recount the summary by the items
# that went away (so a capped index keeps counting what it does not list).
DRIFT_APPLY='def leader: (map(select(.explicit == true)) | sort_by(.id) | first) // (sort_by(.id) | first);
  (.drift // []) as $before
  | ($sel | map(.id)) as $ids
  | .events |= map(if (.id as $i | $ids | index($i)) then . + {resolution: $res, resolutionDetail: $detail}
      + (if $case == "" then {} else {case: $case} end) else . end)
  | . as $root
  | .drift = [($before[]) as $d
      | if ($ids | index($d.eventId)) == null and ($d.members == null or $d.txId == null) then $d
        else ([$root.events[] | select($d.members != null and $d.txId != null and .txId == $d.txId
              and .case == null and .resolution == null)]) as $rest
          | if ($rest | length) == 0 then empty
            elif ($ids | index($d.eventId)) == null then
              if ($rest | length) > 1 then $d + {members: ($rest | length)} else $d | del(.txId, .members) end
            else ($rest | leader) as $l
              | {eventId: $l.id, ts: $l.ts, source: $l.source, kind: $l.kind, subject: $l.subject, detail: $l.detail,
                 actor: $l.actor, zone: $d.zone, crisis: $d.crisis, proposedCase: null}
                + (if ($rest | length) > 1 then {txId: $d.txId, members: ($rest | length)} else {} end)
            end
        end]
  | .summary.openDrift -= (($before | length) - (.drift | length))
  | .summary.crisis -= (([$before[] | select(.crisis)] | length) - ([.drift[] | select(.crisis)] | length))
  | .cases |= with_entries(.value |= map(if .proposedEvents == null then .
      else .proposedEvents |= ([.[] | select(. as $p | $ids | index($p) | not)] | if length == 0 then null else . end) end))'

drift_cmd() { # drift_cmd <link|explain|dismiss> <id> [<case>] [options] [-- <text>]
  local verb=$1 id=${2:-} case_id="" only=false zone="" risk=R1 area="" text="" what index line sel n res detail new=""
  shift 2 || true
  if [[ $verb == link ]]; then
    case_id=${1:-}
    shift || true
  fi
  while (($# > 0)) && [[ $1 != -- ]]; do
    case $1 in
      --only) only=true ;;
      --zone) zone=$2; shift ;;
      --risk) risk=$2; shift ;;
      --area) area=$2; shift ;;
    esac
    shift
  done
  text=${2:-}
  if [[ $verb != link ]]; then
    what="the intent"
    [[ $verb == dismiss ]] && what="the reason"
    [[ -n ${text//[[:space:]]/} ]] || user_error "$what must not be empty"
    [[ $text != *$'\n'* ]] || user_error "$what must be one line"
    text=$(printf '%s' "$text" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  fi
  index=$(state_index)
  # A link names an existing case, also when there is nothing to resolve.
  if [[ $verb == link ]] && { [[ $case_id == "$unknown" ]] \
      || ! jq -e --arg c "$case_id" '[.cases[][] | select(.id == $c)] | length > 0' "$index" >/dev/null 2>&1; }; then
    user_error "unknown case $case_id"
  fi
  jq -e --arg id "$id" 'any(.events[]; .id == $id)' "$index" >/dev/null 2>&1 || user_error "unknown event $id"
  case $verb in
    link) res=linked ;;
    explain) res=explained ;;
    dismiss) res=dismissed ;;
  esac
  # Resolved in the logbook, but the index has not caught up: $HOME/resolved
  # holds "<id> <resolution> [<case>]" lines.
  if [[ -f $HOME/resolved ]] && line=$(grep -m 1 "^$id " "$HOME/resolved"); then
    read -r _ how owner <<<"$line"
    jq -cn --arg id "$id" --arg res "$res" --arg how "$how" --arg owner "${owner:-}" \
      '{eventId: $id, resolution: $res, resolved: 0, events: [], already: {resolution: $how, case: (if $owner == "" then null else $owner end)}}'
    return
  fi
  sel=$(jq -c --arg id "$id" --argjson only "$only" "$DRIFT_DEFS $DRIFT_SELECT" "$index")
  n=$(jq 'length' <<<"$sel")
  if ((n == 0)); then
    jq -c --arg id "$id" --arg res "$res" 'def event($id): [.events[] | select(.id == $id)][0];
      event($id) as $e | {eventId: $id, resolution: $res, resolved: 0, events: [], already: {resolution: $e.resolution, case: $e.case}}' "$index"
    return
  fi
  detail=$text
  [[ $verb == link ]] && detail=""
  if [[ $verb == explain ]]; then
    new=$(printf 'C-2026-%03d' "$(jq '[.cases[][] | .id | capture("^C-2026-(?<n>[0-9]+)$").n | tonumber] | (max // 0) + 1' "$index")")
    [[ -n $zone ]] || zone=$(jq -r --argjson sel "$sel" \
      '([.drift[] | select(.eventId as $x | $sel | map(.id) | index($x))][0].zone) // $sel[0].zone // "yellow"' "$index")
    rewrite_index '.cases.completed = [{id: $new, title: $intent, status: "completed", zone: $zone, risk: $risk, priority: "normal"}
        + (if $area == "" then {} else {area: $area} end)
        + {created: ($sel[0].ts[0:10]), started: ($sel[0].ts[0:10]), closed: "2026-10-01", snapshotBefore: null,
           agents: [], events: ($sel | map(.id)), tags: [], path: ("work/completed/" + $new + "-case.md"), steps: {total: 0, done: 0}}]
        + .cases.completed' \
      --arg new "$new" --arg intent "$text" --arg zone "$zone" --arg risk "$risk" --arg area "$area" --argjson sel "$sel"
  fi
  rewrite_index "$DRIFT_APPLY" --argjson sel "$sel" --arg res "$res" \
    --arg case "${new:-$case_id}" --argjson detail "$(jq -n --arg d "$detail" 'if $d == "" then null else $d end')"
  jq -c --arg id "$id" --arg res "$res" --argjson only "$only" --argjson sel "$sel" --arg case "${new:-$case_id}" \
    --arg detail "$detail" --arg area "$area" --arg verb "$verb" '
    ([.cases[][] | select(.id == $case)][0]) as $c
    | {eventId: $id, resolution: $res, only: $only,
       txId: (if ($sel | length) > 1 then $sel[0].txId else null end),
       resolved: ($sel | length),
       events: [$sel[] | {id: ("01M3W1FAKERES" + (.id[13:26])), source: "seldon", kind: "resolution", subject: .subject,
         refersTo: .id, resolution: $res, case: (if $case == "" then null else $case end),
         detail: (if $detail == "" then null else $detail end)}],
       case: (if $c == null then null else $c end),
       areaCreated: (if $verb == "explain" and $area != "" then $area else null end),
       git: {committed: true, message: ("seldon: drift " + $res + ": " + ($sel | length | tostring) + " event(s)"
         + (if $case == "" then "" else ", " + $case end))}}' "$(state_index)"
}

drift_show() { # drift_show <id>: {event, open, item, txId, members}; members
  # the index no longer lists come from $HOME/extra-events.json (an array).
  local id=$1 index extra='[]'
  index=$(state_index)
  jq -e --arg id "$id" 'any(.events[]; .id == $id)' "$index" >/dev/null 2>&1 || user_error "unknown event $id"
  [[ -f $HOME/extra-events.json ]] && extra=$(<"$HOME/extra-events.json")
  jq -c --arg id "$id" --argjson extra "$extra" "$DRIFT_DEFS"'
    .events += $extra | open_ids as $open | event($id) as $e
    | ([items[] | select(.eventId == $id or (.txId != null and .members != null and .txId == $e.txId))][0]) as $item
    | (if ($open | index($id)) == null then []
       elif $item != null and $item.members != null then
         [.events[] | select(.txId == $item.txId and .case == null and .resolution == null)] | sort_by(.ts, .id)
       else [$e] end) as $m
    | {event: $e, open: ($m | length > 0), item: $item, txId: (if ($m | length) > 1 then $e.txId else null end), members: $m}' "$index"
}

decide() { # decide --no-edit [--json] -- <title>
  local title="" id index
  while (($# > 0)) && [[ $1 != -- ]]; do shift; done
  title=${2:-}
  [[ -n ${title//[[:space:]]/} ]] || user_error "the title must not be empty"
  [[ $title != *$'\n'* ]] || user_error "the title must be one line"
  index=$(state_index)
  id=ADR-0001
  [[ -f $index ]] && id=$(jq -r '[.decisions[] | .id | capture("^ADR-(?<n>[0-9]{4})$").n | tonumber] | (max // 0) + 1
    | tostring | "ADR-" + ("0000"[0:(4 - length)]) + .' "$index")
  rewrite_index '.decisions = [{id: $id, title: $title, status: "proposed", date: "2026-10-01",
      path: ("decisions/" + $id + "-" + ($title | ascii_downcase | gsub("[^a-z0-9]+"; "-") | ltrimstr("-") | rtrimstr("-")
        | if . == "" then "decision" else . end) + ".md")}] + .decisions' --arg id "$id" --arg title "$title"
  jq -c --arg id "$id" '{decision: ([.decisions[] | select(.id == $id)][0] + {cases: []}), editor: null,
    git: {committed: true, message: ($id + " proposed")}}' "$index"
}

# A new case in the state index, in column $2 (queued | active), with the
# tags of the JSON list $8: new_case <id> <status> <title> <zone> <risk> <area> <priority> <tags>
new_case() {
  rewrite_index '.cases[$status] += [{id: $id, title: $title, status: $status, zone: $zone, risk: $risk, priority: $priority}
      + (if $area == "" then {} else {area: $area} end)
      + {created: "2026-10-01", started: (if $status == "active" then "2026-10-01" else null end), closed: null,
         snapshotBefore: null, agents: [], events: [], tags: $tags,
         path: ("work/" + $status + "/" + $id + "-case.md"), steps: {total: 0, done: 0}}]
    | .summary.queuedCases = (.cases.queued | length)
    | .summary.activeCases = (.cases.active | length)' \
    --arg id "$1" --arg status "$2" --arg title "$3" --arg zone "$4" --arg risk "$5" --arg area "$6" \
    --arg priority "$7" --argjson tags "$8"
}

next_id() {
  local index next=9
  index=$(state_index)
  [[ -f $index ]] && next=$(jq '[.cases[][] | .id | capture("^C-2026-(?<n>[0-9]+)$").n | tonumber] | (max // 0) + 1' "$index")
  printf 'C-2026-%03d' "$next"
}

agent_new() { # agent_new [--zone Z] [--risk R] [--area A] [--json] -- <intent>
  local zone=yellow risk=R1 area="" intent title id
  while (($# > 0)) && [[ $1 != -- ]]; do
    case $1 in
      --zone) zone=$2; shift ;;
      --risk) risk=$2; shift ;;
      --area) area=$2; shift ;;
    esac
    shift
  done
  intent=${2:-}
  [[ -n ${intent//[[:space:]]/} ]] || user_error "the intent must not be empty"
  [[ -n ${FAKE_SELDON_NO_DEFAULT_AGENT:-} ]] \
    && user_error "no default agent: Omarchy has none set, so \`omarchy agent prompt\` cannot start one; nothing was created. Fix: \`omarchy default agent <name>\` (e.g. claude), or set \`[agent] launcher\` in ~/.config/seldon/config.toml"
  title=${intent%%$'\n'*}
  title=${title%%. *}
  title=${title%.}
  title=${title:0:72}
  id=$(next_id)
  set_status "$id" active
  new_case "$id" active "$title" "$zone" "$risk" "$area" normal '[]'
  echo "$id" >"$HOME/active-case"
  jq -cn --arg id "$id" --arg title "$title" --arg cwd "$HOME/Seldon" '{launched: true, launcher: "default", program: "omarchy",
    argv: ["omarchy", "agent", "prompt", "{prompt}"], actor: "agent:default", case: $id, cwd: $cwd, previousActiveCase: null,
    created: {case: {id: $id, title: $title, status: "active"}, events: [], areaCreated: null, git: {committed: true}}}'
}

plan_reopen() { # plan_reopen <id>
  local id=$1 from index old new earlier
  [[ $id == "$unknown" ]] && user_error "unknown case $id"
  from=$(case_status "$id")
  [[ -n $from ]] || user_error "unknown case $id"
  [[ $from == completed ]] || user_error "$id is $from; \`seldon plan reopen\` reopens a completed case only"
  index=$(state_index)
  old=$(jq -c --arg id "$id" '[.cases[][] | select(.id == $id)][0]' "$index")
  earlier=$(jq -c --arg tag "reopens:$id" '[.cases[][] | select((.tags // []) | index($tag)) | .id]' "$index")
  new=$(next_id)
  local held="" held_status=""
  [[ -f $HOME/active-case ]] && held=$(<"$HOME/active-case")
  [[ -n $held ]] && held_status=$(case_status "$held")
  [[ $held_status == queued || $held_status == active || $held_status == verification ]] || held=""
  set_status "$new" active
  new_case "$new" active "Reopen: $(jq -r .title <<<"$old")" "$(jq -r .zone <<<"$old")" "$(jq -r .risk <<<"$old")" \
    "$(jq -r '.area // ""' <<<"$old")" "$(jq -r '.priority // "normal"' <<<"$old")" "[\"reopens:$id\"]"
  [[ -z $held ]] && echo "$new" >"$HOME/active-case"
  jq -cn --arg id "$new" --arg old "$id" --argjson earlier "$earlier" --arg held "$held" '{
    case: {id: $id, status: "active", tags: ["reopens:" + $old]}, reopens: $old, earlier: $earlier,
    events: [], activeCase: (if $held == "" then {set: $id} else {kept: $held} end),
    git: {committed: true, message: ($old + " reopened as " + $id)}}'
}

agent_start() { # agent_start <id> — the engine's checks and answer, no launch
  local id=$1 status
  [[ $id == "$unknown" ]] && user_error "unknown case $id"
  status=$(case_status "$id")
  [[ -n $status ]] || user_error "unknown case $id"
  [[ $status == queued ]] && user_error "$id is queued; start it first: \`seldon plan start $id\`"
  [[ $status == active ]] || user_error "$id has status $status; an agent starts on an active case only"
  [[ -n ${FAKE_SELDON_NO_LAUNCHER:-} ]] \
    && user_error "launcher \`default\`: \`omarchy\` not found; set \`[agent] launcher\` in config.toml"
  echo "$id" >"$HOME/active-case"
  jq -cn --arg id "$id" --arg cwd "$HOME/Seldon" '{launched: true, launcher: "default", program: "omarchy",
    argv: ["omarchy", "agent", "prompt", "{prompt}"], case: $id, cwd: $cwd, previousActiveCase: null}'
}

case "$cmd" in
  --version)
    echo '{"name":"seldon","version":"0.1.0-fake"}'
    ;;
  capture)
    sleep 0.3
    [[ $mode == uninit ]] && uninit
    call=1
    [[ -f $HOME/capture-calls ]] && call=$(($(<"$HOME/capture-calls") + 1))
    echo "$call" >"$HOME/capture-calls"
    # in_list <comma list> — this capture call is one of them
    in_list() { [[ ,$1, == *,$call,* ]]; }
    if [[ -n ${FAKE_SELDON_CAPTURE_EXIT:-} ]] \
      && { [[ -z ${FAKE_SELDON_CAPTURE_EXIT_CALLS:-} ]] || in_list "$FAKE_SELDON_CAPTURE_EXIT_CALLS"; }; then
      err=${FAKE_SELDON_CAPTURE_STDERR-$'seldon: collector failed\nsecond line'}
      [[ -n $err ]] && printf '%s\n' "$err" >&2
      [[ -n ${FAKE_SELDON_CAPTURE_STDOUT:-} ]] && printf '%s\n' "$FAKE_SELDON_CAPTURE_STDOUT"
      exit "$FAKE_SELDON_CAPTURE_EXIT"
    fi
    locked=0
    [[ -f $HOME/locked-captures ]] && locked=$(<"$HOME/locked-captures")
    if ((locked < ${FAKE_SELDON_CAPTURE_LOCKED:-0})); then
      echo $((locked + 1)) >"$HOME/locked-captures"
      echo "{\"error\":{\"code\":4,\"message\":\"another seldon process holds the lock $HOME/.local/state/seldon/lock\"}}"
      exit 4
    fi
    n=0
    [[ -f $HOME/captures ]] && n=$(<"$HOME/captures")
    echo $((n + 1)) >"$HOME/captures"
    warnings=${FAKE_SELDON_CAPTURE_WARNINGS:-[]}
    [[ -n ${FAKE_SELDON_CAPTURE_WARNED:-} ]] && ! in_list "$FAKE_SELDON_CAPTURE_WARNED" && warnings=[]
    echo "{\"ok\":true,\"logbook\":\"$HOME/Seldon\",\"written\":${FAKE_SELDON_WRITTEN:-0},\"files\":[],\"collectors\":[{\"name\":\"pacman\",\"enabled\":true,\"ran\":true,\"ok\":true,\"events\":${FAKE_SELDON_WRITTEN:-0}}],\"warnings\":$warnings}"
    ;;
  status)
    sleep 0.3
    [[ $mode == uninit ]] && uninit
    state=${XDG_STATE_HOME:-}
    [[ $state == /* ]] || state="$HOME/.local/state"
    dir="$state/seldon"
    mkdir -p "$dir"
    fixture=$FAKE_SELDON_FIXTURE
    captures=0
    [[ -f $HOME/captures ]] && captures=$(<"$HOME/captures")
    [[ -n ${FAKE_SELDON_FIXTURE_AFTER:-} && $captures -ge 2 ]] && fixture=$FAKE_SELDON_FIXTURE_AFTER
    now=$(date --iso-8601=seconds)
    sed "s/\"generatedAt\": \"[^\"]*\"/\"generatedAt\": \"$now\"/" "$fixture" >"$dir/index.json.tmp"
    mv "$dir/index.json.tmp" "$dir/index.json"
    echo '{"ok":true}'
    ;;
  log)
    sleep 0.2
    [[ $mode == uninit ]] && uninit
    shift
    case_id=""
    while (($# > 0)) && [[ $1 != -- ]]; do
      [[ $1 == --case ]] && { case_id=$2; shift; }
      shift
    done
    [[ -n $case_id && $case_id == "$unknown" ]] && user_error "unknown case $case_id"
    if [[ -n $case_id ]]; then subject=$case_id; case_json="\"$case_id\""; else subject=journal; case_json=null; fi
    echo "{\"event\":{\"id\":\"01M3W1FAKE0000000000000NTE\",\"ts\":\"2026-10-01T18:00:00+02:00\",\"source\":\"manual\",\"kind\":\"note\",\"subject\":\"$subject\",\"actor\":\"human\",\"case\":$case_json},\"git\":null}"
    ;;
  open)
    [[ $mode == uninit ]] && uninit
    what=${2:-}
    case "$what" in
      journal) path="$HOME/Seldon/journal/2026/2026-10-01.md" ;;
      ledger) path="$HOME/Seldon/ledger/2026-10.jsonl" ;;
      status) path="$HOME/Seldon/STATUS.md" ;;
      logbook) path="$HOME/Seldon" ;;
      ADR-*)
        rel=$(jq -r --arg id "$what" '[.decisions[] | select(.id == $id) | .path][0] // empty' "$(state_index)" 2>/dev/null || true)
        [[ -n $rel ]] || user_error "unknown decision $what"
        path="$HOME/Seldon/$rel"
        ;;
      C-*)
        [[ $what == "$unknown" ]] && user_error "unknown case $what"
        path="$HOME/Seldon/work/active/$what.md"
        ;;
      *) user_error "cannot open \`$what\`" ;;
    esac
    command -v omarchy-launch-editor >/dev/null \
      || user_error "cannot open $path: no terminal and no omarchy-launch-editor; set \$EDITOR or open the path yourself"
    omarchy-launch-editor "$path"
    echo "{\"what\":\"$what\",\"path\":\"$path\",\"editor\":{\"launched\":true,\"program\":\"omarchy-launch-editor\"}}"
    ;;
  plan)
    sleep 0.2
    [[ $mode == uninit ]] && uninit
    if [[ -n ${FAKE_SELDON_LOCKED:-} ]]; then
      echo '{"error":{"code":4,"message":"the logbook is locked by another seldon (pid 4242)"}}'
      exit 4
    fi
    case "${2:-}" in
      new) shift 2; plan_new "$@" ;;
      start | verify | done | drop) plan_step "$2" "${3:-}" ;;
      reopen) plan_reopen "${3:-}" ;;
      *) user_error "unrecognized subcommand '${2:-}'" ;;
    esac
    ;;
  decide)
    sleep 0.2
    [[ $mode == uninit ]] && uninit
    if [[ -n ${FAKE_SELDON_LOCKED:-} ]]; then
      echo '{"error":{"code":4,"message":"the logbook is locked by another seldon (pid 4242)"}}'
      exit 4
    fi
    shift
    decide "$@"
    ;;
  drift)
    sleep 0.2
    [[ $mode == uninit ]] && uninit
    case "${2:-}" in
      show) drift_show "${3:-}" ;;
      link | explain | dismiss)
        if [[ -n ${FAKE_SELDON_LOCKED:-} ]]; then
          echo '{"error":{"code":4,"message":"the logbook is locked by another seldon (pid 4242)"}}'
          exit 4
        fi
        shift
        drift_cmd "$@"
        ;;
      *) user_error "unrecognized subcommand '${2:-}'" ;;
    esac
    ;;
  agent)
    sleep 0.2
    [[ $mode == uninit ]] && uninit
    if [[ -n ${FAKE_SELDON_LOCKED:-} ]]; then
      echo '{"error":{"code":4,"message":"the logbook is locked by another seldon (pid 4242)"}}'
      exit 4
    fi
    case "${2:-}" in
      start)
        if [[ ${3:-} == --new ]]; then
          shift 3
          agent_new "$@"
        else
          agent_start "${3:-}"
        fi
        ;;
      *) user_error "unrecognized subcommand '${2:-}'" ;;
    esac
    ;;
  rules)
    sleep 0.2
    [[ $mode == uninit ]] && uninit
    [[ ${2:-} == update ]] || user_error "unrecognized subcommand '${2:-}'"
    # $HOME/rules-fail: the update refuses with that text (WP-111)
    [[ -f $HOME/rules-fail ]] && user_error "$(<"$HOME/rules-fail")"
    echo current >"$HOME/rules"
    echo '{"file":"AGENTS.md","action":"rewritten","from":"v2","version":3,"archived":"archive/AGENTS-2026-10-06.md","diff":"","git":{"committed":true}}'
    ;;
  *)
    user_error "unrecognized subcommand"
    ;;
esac
