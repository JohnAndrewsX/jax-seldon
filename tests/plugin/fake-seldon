#!/usr/bin/env bash
# Fake `seldon` for tests/plugin/service-states.sh. Speaks just enough of the
# CLI (SPEC-ENGINE §3) for the plugin service: --version, capture, status.
# Every call is logged to $HOME/calls.log as "start <cmd>" / "end <cmd>" so
# the test can prove calls never overlap.
#
#   FAKE_SELDON_MODE     ok (default) | uninit; $HOME/mode overrides it, so a
#                        test can run `seldon init` halfway through
#   FAKE_SELDON_FIXTURE  index written by `status` in mode ok; generatedAt is
#                        replaced with the current time
set -euo pipefail

log="$HOME/calls.log"
cmd="${1:-}"
mode=${FAKE_SELDON_MODE:-ok}
[[ -f $HOME/mode ]] && mode=$(<"$HOME/mode")
echo "start $cmd" >>"$log"
trap 'echo "end $cmd" >>"$log"' EXIT

case "$cmd" in
  --version)
    echo '{"name":"seldon","version":"0.1.0-fake"}'
    ;;
  capture)
    sleep 0.3
    if [[ $mode == uninit ]]; then
      echo '{"error":{"code":3,"message":"logbook not initialised"}}'
      exit 3
    fi
    echo '{"events":0}'
    ;;
  status)
    sleep 0.3
    if [[ $mode == uninit ]]; then
      echo '{"error":{"code":3,"message":"logbook not initialised"}}'
      exit 3
    fi
    dir="$HOME/.local/state/seldon"
    mkdir -p "$dir"
    now=$(date --iso-8601=seconds)
    sed "s/\"generatedAt\": \"[^\"]*\"/\"generatedAt\": \"$now\"/" "$FAKE_SELDON_FIXTURE" >"$dir/index.json.tmp"
    mv "$dir/index.json.tmp" "$dir/index.json"
    echo '{"ok":true}'
    ;;
  *)
    echo "{\"error\":{\"code\":1,\"message\":\"unrecognized subcommand\"}}"
    exit 1
    ;;
esac
