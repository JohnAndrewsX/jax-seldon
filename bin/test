#!/bin/sh
# The app's Qt tests (offscreen, own HOME and runtime dir), then the engine's
# unit tests. The full gate is `just check`.
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"

"$ROOT/app/bin/test" "$@"
cargo test --manifest-path "$ROOT/engine/Cargo.toml" --locked --features watch --lib --bins
