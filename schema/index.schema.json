{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohnAndrewsX/jax-seldon/schema/index.schema.json",
  "title": "Seldon index — the only input of the plugin",
  "description": "Written by the engine to ~/.local/state/seldon/index.json. Derivation rules: ADR-0012.",
  "type": "object",
  "required": ["contractVersion", "generatedAt", "engineVersion", "logbook", "state", "summary", "today", "events", "drift", "cases", "decisions", "system", "memory", "series"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": 2 },
    "generatedAt":   { "type": "string", "format": "date-time" },
    "engineVersion": { "type": "string" },
    "logbook": {
      "type": "object", "required": ["path", "language", "machine"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" }, "language": { "type": "string" },
        "machine": { "type": "string" },
        "git": { "type": "object", "additionalProperties": false, "properties": { "head": { "type": "string" }, "dirty": { "type": "boolean" },
          "autocommit": { "type": "object", "required": ["ok", "at", "message"], "additionalProperties": false,
            "description": "the last autocommit the engine attempted in this logbook (ADR-0035 §2); absent while git.autocommit is off or none was attempted",
            "properties": { "ok": { "type": "boolean" }, "at": { "type": "string", "format": "date-time" },
              "message": { "type": "string", "maxLength": 256, "description": "ok: the commit subject; not ok: the git error (one line, redacted); shown, never executed" } } } } }
      }
    },
    "state": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {
        "status":  { "enum": ["ok", "notInitialised", "indexStale"] },
        "lastCapture": { "type": ["string", "null"], "format": "date-time" },
        "collectors": { "type": "array", "items": { "type": "object", "required": ["name", "enabled", "ok"], "additionalProperties": false,
          "properties": {
            "name": { "enum": ["pacman", "snapper", "omarchy", "plugins", "theme", "config"] },
            "enabled": { "type": "boolean" }, "ok": { "type": "boolean" },
            "message": { "type": "string", "description": "engine message (English); shown, never executed" },
            "lastRun": { "type": ["string", "null"], "format": "date-time" } } } }
      }
    },
    "summary": {
      "type": "object", "required": ["activeCases", "queuedCases", "openDrift", "crisis", "eventsToday", "events7d"], "additionalProperties": false,
      "properties": {
        "activeCases": { "type": "integer", "minimum": 0 }, "queuedCases": { "type": "integer", "minimum": 0 },
        "openDrift": { "type": "integer", "minimum": 0 }, "crisis": { "type": "integer", "minimum": 0 },
        "eventsToday": { "type": "integer", "minimum": 0 }, "events7d": { "type": "integer", "minimum": 0 }
      }
    },
    "today": {
      "type": "object", "required": ["date", "entries"], "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "path": { "type": "string" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/journalEntry" } },
        "yesterday": { "type": "array", "items": { "$ref": "#/$defs/journalEntry" } }
      }
    },
    "events": { "type": "array", "maxItems": 500, "items": { "$ref": "event.schema.json" }, "description": "newest first; resolution events are not listed, they are folded onto their target (resolution, resolutionDetail when the resolution has a detail, and case when linked; ADR-0012 §8, §11)" },
    "drift":  { "type": "array", "items": { "$ref": "#/$defs/drift" }, "description": "open drift items, newest first; open caseless pacman events of one transaction form one item (ADR-0013)" },
    "cases":  { "type": "object", "required": ["queued", "active", "verification", "completed"], "additionalProperties": false,
      "properties": {
        "queued": { "type": "array", "items": { "$ref": "case.schema.json" } },
        "active": { "type": "array", "items": { "$ref": "case.schema.json" } },
        "verification": { "type": "array", "items": { "$ref": "case.schema.json" } },
        "completed": { "type": "array", "maxItems": 50, "items": { "$ref": "case.schema.json" }, "description": "completed and dropped cases, newest closed first" }
      } },
    "decisions": { "type": "array", "items": { "type": "object", "required": ["id", "title", "status", "date", "cases"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" }, "title": { "type": "string" }, "status": { "enum": ["proposed", "accepted", "superseded"] }, "date": { "type": "string", "format": "date" }, "path": { "type": "string" },
        "cases": { "type": "array", "items": { "$ref": "event.schema.json#/$defs/caseId" }, "description": "the frontmatter's cases, as written, without repeats; may name a case the index does not list (ADR-0035 §5)" },
        "lead": { "type": "string", "minLength": 1, "maxLength": 256, "description": "the first paragraph of the decision's ## Decision, without direction and format characters, redacted, clipped to 256 bytes of JSON with the marker '… (N more characters in the file)'; absent without one (ADR-0038 §2)" } } } },
    "triage": { "type": "object", "required": ["id", "at", "actor", "counts", "path", "applied"], "additionalProperties": false,
      "description": "the newest triage proposal of this logbook (ADR-0034 §6, ADR-0035 §6); absent when there is none",
      "properties": {
        "id": { "$ref": "event.schema.json#/$defs/ulid" },
        "at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "pattern": "^agent:[a-z0-9-]+$" },
        "counts": { "type": "object", "required": ["items", "crises"], "additionalProperties": false,
          "properties": { "items": { "type": "integer", "minimum": 0 }, "crises": { "type": "integer", "minimum": 0 } } },
        "path": { "type": "string", "pattern": "^proposals/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$", "description": "relative to the directory of index.json; the file is proposal.schema.json" },
        "applied": { "type": ["string", "null"], "format": "date-time", "description": "null until `seldon drift apply` applied it" } } },
    "system": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "omarchy": { "type": "object", "additionalProperties": false, "properties": { "version": { "type": "string" }, "repoHead": { "type": "string", "description": "only for git checkouts of Omarchy; package installs omit it" }, "theme": { "type": "string" }, "lastUpdate": { "type": ["string", "null"], "format": "date-time" } } },
        "packages": { "type": "object", "additionalProperties": false, "properties": { "explicit": { "type": "integer" }, "total": { "type": "integer" }, "aur": { "type": "integer" } } },
        "deviations": { "type": "integer", "minimum": 0 },
        "snapshots": { "type": "array", "maxItems": 10, "items": { "type": "object", "required": ["number", "ts"], "additionalProperties": false, "properties": { "number": { "type": "integer" }, "ts": { "type": "string", "format": "date-time" }, "description": { "type": "string" }, "type": { "enum": ["single", "pre", "post"] } } } },
        "plugins": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "integer" }, "installed": { "type": "integer" } } },
        "areas": { "type": "array", "items": { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "hasAgentsMd": { "type": "boolean" }, "cases": { "type": "integer" } } } },
        "recentConfig": { "type": "object", "required": ["scannedAt", "files"], "additionalProperties": false,
          "description": "optional (ADR-0046): files under ~/.config modified in the 7 days before the last capture's scan, outside watchPaths and skipPaths, newest first; paths and times only, never content; absent before the first scan or with an invalid [redaction] patterns entry; `partial` marks an incomplete list",
          "properties": {
            "scannedAt": { "type": "string", "format": "date-time" },
            "files": { "type": "array", "maxItems": 80, "items": { "type": "object", "required": ["path", "mtime"], "additionalProperties": false, "properties": { "path": { "type": "string", "pattern": "^~/\\.config/", "maxLength": 512, "description": "user content (CONTRACT.md rule 6); passed only as the one argument after -- of `seldon config watch --json`" }, "mtime": { "type": "string", "format": "date-time" } } } },
            "partial": { "const": true, "description": "present only when the scan stopped early (entry budget, deadline) or left folders below its depth unread: the list may be incomplete" } } }
      }
    },
    "memory": { "type": "object", "additionalProperties": false, "properties": {
      "lessons": { "type": "array", "items": { "type": "string" }, "description": "headings of memory/lessons.md" },
      "topics": { "type": "array", "items": { "type": "object", "required": ["topic", "path"], "additionalProperties": false, "properties": { "topic": { "type": "string" }, "updated": { "type": "string", "format": "date" }, "path": { "type": "string" } } } } } },
    "series": {
      "type": "object", "required": ["heatmap", "packages", "drift"], "additionalProperties": false,
      "properties": {
        "heatmap":  { "type": "array", "maxItems": 366, "items": { "type": "object", "required": ["date", "total"], "additionalProperties": false, "properties": { "date": { "type": "string", "format": "date" }, "total": { "type": "integer", "minimum": 0 }, "bySource": { "type": "object", "propertyNames": { "$ref": "event.schema.json#/properties/source" }, "additionalProperties": { "type": "integer" } } } } },
        "packages": { "type": "array", "items": { "type": "object", "required": ["date", "explicit"], "additionalProperties": false, "properties": { "date": { "type": "string", "format": "date" }, "explicit": { "type": "integer" }, "total": { "type": "integer" } } } },
        "drift":    { "type": "array", "description": "per ISO week: drift items opened and resolution writes; a pacman group counts once on both sides (ADR-0013 §4)", "items": { "type": "object", "required": ["week", "opened", "resolved"], "additionalProperties": false, "properties": { "week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" }, "opened": { "type": "integer" }, "resolved": { "type": "integer" } } } },
        "risk":     { "type": "object", "propertyNames": { "enum": ["R0", "R1", "R2", "R3"] }, "additionalProperties": { "type": "integer" } },
        "timeline": { "type": "array", "items": { "type": "object", "required": ["kind", "ts", "label"], "additionalProperties": false, "properties": { "kind": { "enum": ["release", "snapshot", "case", "crisis"] }, "ts": { "type": "string", "description": "two forms (ADR-0012 §12): YYYY-MM-DD for case spans (the case's created), RFC 3339 date-time for release, snapshot and crisis" }, "end": { "type": ["string", "null"], "description": "case spans only: YYYY-MM-DD (closed), null while the case is open; absent for the other kinds" }, "label": { "type": "string" }, "ref": { "type": "string" } } } }
      }
    }
  },
  "$defs": {
    "journalEntry": { "type": "object", "required": ["time", "actor", "text"], "additionalProperties": false,
      "properties": { "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }, "actor": { "$ref": "event.schema.json#/$defs/actor" }, "case": { "anyOf": [ { "$ref": "event.schema.json#/$defs/caseId" }, { "type": "null" } ] }, "text": { "type": "string" } } },
    "drift": { "type": "object", "required": ["eventId", "ts", "source", "kind", "subject", "actor", "crisis"], "additionalProperties": false,
      "description": "One open drift item: a single event, or a pacman transaction group (ADR-0013). A group's ts, source, kind, subject, detail, actor and proposedCase are the leader's (lowest-id explicit member, else lowest-id member); its members have no rows of their own.",
      "properties": {
        "eventId": { "$ref": "event.schema.json#/$defs/ulid", "description": "the event's id; for a group the leader's id (the drift key stays an event id, ADR-0008)" },
        "ts": { "type": "string", "format": "date-time" },
        "source": { "enum": ["pacman", "omarchy", "plugins", "theme", "config"], "description": "only system-changing collectors produce drift (ADR-0012)" },
        "kind": { "$ref": "event.schema.json#/properties/kind" },
        "subject": { "type": "string" }, "detail": { "type": "string" },
        "actor": { "$ref": "event.schema.json#/$defs/actor" },
        "zone": { "enum": ["green", "yellow", "red"], "description": "the leader's ledger zone: where the change acts (ADR-0014; pacman items are red); not the class (ADR-0028 §7). Under [drift] attention = \"all\" the rule before ADR-0028: for pacman items yellow iff every member is routine, else red (ADR-0013 §3)" },
        "crisis": { "type": "boolean", "description": "true iff the item fails the harm test of ADR-0028 (its class is crisis: a named transaction on an alwaysRed package, a write to a persistence path); under [drift] attention = \"all\" true iff zone is red" },
        "proposedCase": { "anyOf": [ { "$ref": "event.schema.json#/$defs/caseId" }, { "type": "null" } ] },
        "txId": { "type": "string", "minLength": 1, "description": "groups only: the shared pacman txId; expand the group from index.events by txId (ADR-0013 §2)" },
        "members": { "type": "integer", "minimum": 2, "description": "groups only: number of open member events incl. the leader; omitted for single-event items" },
        "truncated": { "const": true, "description": "detail was clipped (ADR-0025, ADR-0035 §3); absent otherwise" },
        "rule": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64, "description": "the ADR-0028 §2 rule that classified the item, as `seldon drift show` reports it (`attention-all` under [drift] attention = \"all\"); the set is open (ADR-0038 §1)" } },
      "allOf": [
        { "if": { "required": ["members"] }, "then": { "required": ["txId"], "properties": { "source": { "const": "pacman" } } } },
        { "if": { "required": ["txId"] }, "then": { "required": ["members"] } }
      ] }
  }
}
