{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohnAndrewsX/jax-seldon/schema/index.schema.json",
  "title": "Seldon index — the only input of the plugin",
  "description": "Written by the engine to ~/.local/state/seldon/index.json. Derivation rules: ADR-0012.",
  "type": "object",
  "required": ["contractVersion", "generatedAt", "engineVersion", "logbook", "state", "summary", "today", "events", "drift", "cases", "decisions", "system", "memory", "series"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": 1 },
    "generatedAt":   { "type": "string", "format": "date-time" },
    "engineVersion": { "type": "string" },
    "logbook": {
      "type": "object", "required": ["path", "language", "machine"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" }, "language": { "type": "string" },
        "machine": { "type": "string" },
        "git": { "type": "object", "additionalProperties": false, "properties": { "head": { "type": "string" }, "dirty": { "type": "boolean" } } }
      }
    },
    "state": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {
        "status":  { "enum": ["ok", "notInitialised", "indexStale"] },
        "lastCapture": { "type": ["string", "null"], "format": "date-time" },
        "collectors": { "type": "array", "items": { "type": "object", "required": ["name", "enabled", "ok"], "additionalProperties": false,
          "properties": {
            "name": { "enum": ["pacman", "snapper", "omarchy", "plugins", "theme", "config"] },
            "enabled": { "type": "boolean" }, "ok": { "type": "boolean" },
            "message": { "type": "string", "description": "engine message (English); shown, never executed" },
            "lastRun": { "type": ["string", "null"], "format": "date-time" } } } }
      }
    },
    "summary": {
      "type": "object", "required": ["activeCases", "queuedCases", "openDrift", "crisis", "eventsToday", "events7d"], "additionalProperties": false,
      "properties": {
        "activeCases": { "type": "integer", "minimum": 0 }, "queuedCases": { "type": "integer", "minimum": 0 },
        "openDrift": { "type": "integer", "minimum": 0 }, "crisis": { "type": "integer", "minimum": 0 },
        "eventsToday": { "type": "integer", "minimum": 0 }, "events7d": { "type": "integer", "minimum": 0 }
      }
    },
    "today": {
      "type": "object", "required": ["date", "entries"], "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "path": { "type": "string" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/journalEntry" } },
        "yesterday": { "type": "array", "items": { "$ref": "#/$defs/journalEntry" } }
      }
    },
    "events": { "type": "array", "maxItems": 500, "items": { "$ref": "event.schema.json" }, "description": "newest first; resolution events are not listed, they are folded onto their target (resolution, and case when linked)" },
    "drift":  { "type": "array", "items": { "$ref": "#/$defs/drift" }, "description": "open drift, newest first" },
    "cases":  { "type": "object", "required": ["queued", "active", "verification", "completed"], "additionalProperties": false,
      "properties": {
        "queued": { "type": "array", "items": { "$ref": "case.schema.json" } },
        "active": { "type": "array", "items": { "$ref": "case.schema.json" } },
        "verification": { "type": "array", "items": { "$ref": "case.schema.json" } },
        "completed": { "type": "array", "maxItems": 50, "items": { "$ref": "case.schema.json" }, "description": "completed and dropped cases, newest closed first" }
      } },
    "decisions": { "type": "array", "items": { "type": "object", "required": ["id", "title", "status", "date"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" }, "title": { "type": "string" }, "status": { "enum": ["proposed", "accepted", "superseded"] }, "date": { "type": "string", "format": "date" }, "path": { "type": "string" } } } },
    "system": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "omarchy": { "type": "object", "additionalProperties": false, "properties": { "version": { "type": "string" }, "repoHead": { "type": "string", "description": "only for git checkouts of Omarchy; package installs omit it" }, "theme": { "type": "string" }, "lastUpdate": { "type": ["string", "null"], "format": "date-time" } } },
        "packages": { "type": "object", "additionalProperties": false, "properties": { "explicit": { "type": "integer" }, "total": { "type": "integer" }, "aur": { "type": "integer" } } },
        "deviations": { "type": "integer", "minimum": 0 },
        "snapshots": { "type": "array", "maxItems": 10, "items": { "type": "object", "required": ["number", "ts"], "additionalProperties": false, "properties": { "number": { "type": "integer" }, "ts": { "type": "string", "format": "date-time" }, "description": { "type": "string" }, "type": { "enum": ["single", "pre", "post"] } } } },
        "plugins": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "integer" }, "installed": { "type": "integer" } } },
        "areas": { "type": "array", "items": { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "hasAgentsMd": { "type": "boolean" }, "cases": { "type": "integer" } } } }
      }
    },
    "memory": { "type": "object", "additionalProperties": false, "properties": {
      "lessons": { "type": "array", "items": { "type": "string" }, "description": "headings of memory/lessons.md" },
      "topics": { "type": "array", "items": { "type": "object", "required": ["topic", "path"], "additionalProperties": false, "properties": { "topic": { "type": "string" }, "updated": { "type": "string", "format": "date" }, "path": { "type": "string" } } } } } },
    "series": {
      "type": "object", "required": ["heatmap", "packages", "drift"], "additionalProperties": false,
      "properties": {
        "heatmap":  { "type": "array", "maxItems": 366, "items": { "type": "object", "required": ["date", "total"], "additionalProperties": false, "properties": { "date": { "type": "string", "format": "date" }, "total": { "type": "integer", "minimum": 0 }, "bySource": { "type": "object", "propertyNames": { "$ref": "event.schema.json#/properties/source" }, "additionalProperties": { "type": "integer" } } } } },
        "packages": { "type": "array", "items": { "type": "object", "required": ["date", "explicit"], "additionalProperties": false, "properties": { "date": { "type": "string", "format": "date" }, "explicit": { "type": "integer" }, "total": { "type": "integer" } } } },
        "drift":    { "type": "array", "items": { "type": "object", "required": ["week", "opened", "resolved"], "additionalProperties": false, "properties": { "week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" }, "opened": { "type": "integer" }, "resolved": { "type": "integer" } } } },
        "risk":     { "type": "object", "propertyNames": { "enum": ["R0", "R1", "R2", "R3"] }, "additionalProperties": { "type": "integer" } },
        "timeline": { "type": "array", "items": { "type": "object", "required": ["kind", "ts", "label"], "additionalProperties": false, "properties": { "kind": { "enum": ["release", "snapshot", "case", "crisis"] }, "ts": { "type": "string" }, "end": { "type": ["string", "null"] }, "label": { "type": "string" }, "ref": { "type": "string" } } } }
      }
    }
  },
  "$defs": {
    "journalEntry": { "type": "object", "required": ["time", "actor", "text"], "additionalProperties": false,
      "properties": { "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }, "actor": { "$ref": "event.schema.json#/$defs/actor" }, "case": { "anyOf": [ { "$ref": "event.schema.json#/$defs/caseId" }, { "type": "null" } ] }, "text": { "type": "string" } } },
    "drift": { "type": "object", "required": ["eventId", "ts", "source", "kind", "subject", "actor", "crisis"], "additionalProperties": false,
      "properties": {
        "eventId": { "$ref": "event.schema.json#/$defs/ulid" },
        "ts": { "type": "string", "format": "date-time" },
        "source": { "enum": ["pacman", "omarchy", "plugins", "theme", "config"], "description": "only system-changing collectors produce drift (ADR-0012)" },
        "kind": { "$ref": "event.schema.json#/properties/kind" },
        "subject": { "type": "string" }, "detail": { "type": "string" },
        "actor": { "$ref": "event.schema.json#/$defs/actor" },
        "zone": { "enum": ["green", "yellow", "red"] },
        "crisis": { "type": "boolean", "description": "true iff zone is red" },
        "proposedCase": { "anyOf": [ { "$ref": "event.schema.json#/$defs/caseId" }, { "type": "null" } ] } } }
  }
}
