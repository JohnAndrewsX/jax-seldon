{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohnAndrewsX/jax-seldon/schema/external/claude-code-hook.schema.json",
  "title": "Claude Code PreToolUse / PostToolUse hook payload (stdin of `seldon hook claude-code`)",
  "description": "Third-party input format, not part of the contract. Only tool_input.command (Bash) is read by the engine; tool_response is never recorded (SPEC-ENGINE §7). Extra fields may appear in newer Claude Code versions.",
  "type": "object",
  "required": ["session_id", "hook_event_name", "tool_name", "tool_input", "cwd"],
  "properties": {
    "session_id": { "type": "string" },
    "transcript_path": { "type": "string" },
    "cwd": { "type": "string" },
    "permission_mode": { "type": "string" },
    "hook_event_name": { "enum": ["PreToolUse", "PostToolUse"] },
    "tool_name": { "type": "string" },
    "tool_use_id": { "type": "string" },
    "tool_input": { "type": "object" },
    "tool_response": { "type": ["object", "string"] }
  },
  "allOf": [
    { "if": { "properties": { "tool_name": { "const": "Bash" } }, "required": ["tool_name"] },
      "then": { "properties": { "tool_input": { "required": ["command"], "properties": { "command": { "type": "string" } } } } } },
    { "if": { "properties": { "hook_event_name": { "const": "PostToolUse" } }, "required": ["hook_event_name"] },
      "then": { "required": ["tool_response"] } }
  ]
}
