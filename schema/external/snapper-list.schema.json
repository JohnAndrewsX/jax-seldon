{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohnAndrewsX/jax-seldon/schema/external/snapper-list.schema.json",
  "title": "Output of `snapper --jsonout list` (snapper 0.13)",
  "description": "Third-party input format, not part of the contract. Keyed by config name. Not verified on the dev host (needs ALLOW_USERS, ADR-0011); shape from snapper upstream. `date` is local time without offset; snapshot 0 is 'current' with an empty date.",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["number", "type", "date", "description"],
      "properties": {
        "subvolume": { "type": "string" },
        "number": { "type": "integer", "minimum": 0 },
        "default": { "type": "boolean" },
        "active": { "type": "boolean" },
        "type": { "enum": ["single", "pre", "post"] },
        "pre-number": { "type": ["integer", "null"] },
        "date": { "type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$" },
        "user": { "type": "string" },
        "used-space": { "type": ["integer", "null"] },
        "cleanup": { "type": "string" },
        "description": { "type": "string" },
        "userdata": { "type": ["object", "null"], "additionalProperties": { "type": "string" } }
      }
    }
  }
}
