{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohnAndrewsX/jax-seldon/schema/case.schema.json",
  "title": "Seldon case (frontmatter + derived fields as they appear in the index)",
  "type": "object",
  "required": ["id", "title", "status", "zone", "risk", "created"],
  "additionalProperties": false,
  "properties": {
    "id":       { "type": "string", "pattern": "^C-[0-9]{4}-[0-9]{3,}$" },
    "title":    { "type": "string" },
    "status":   { "enum": ["queued", "active", "verification", "completed", "dropped"] },
    "zone":     { "enum": ["green", "yellow", "red"] },
    "risk":     { "enum": ["R0", "R1", "R2", "R3"] },
    "priority": { "enum": ["high", "normal", "low"], "default": "normal" },
    "area":     { "type": "string" },
    "created":  { "type": "string", "format": "date" },
    "started":  { "type": ["string", "null"], "format": "date" },
    "closed":   { "type": ["string", "null"], "format": "date" },
    "snapshotBefore": { "type": ["integer", "null"] },
    "agents":   { "type": "array", "items": { "type": "string" } },
    "events":   { "type": "array", "items": { "type": "string" } },
    "tags":     { "type": "array", "items": { "type": "string" } },
    "path":     { "type": "string", "description": "relative to logbook root" },
    "steps":    { "type": "object", "properties": { "total": { "type": "integer" }, "done": { "type": "integer" } } },
    "proposedEvents": { "type": "array", "items": { "type": "string" }, "description": "drift events the engine thinks belong here" }
  }
}
