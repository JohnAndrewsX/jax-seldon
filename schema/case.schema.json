{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohnAndrewsX/jax-seldon/schema/case.schema.json",
  "title": "Seldon case (frontmatter + derived fields as they appear in the index)",
  "description": "Validates the YAML frontmatter of work/*/C-*.md (where `type: case` appears) and the case objects in index.cases (where path, steps and proposedEvents are added by the engine).",
  "type": "object",
  "required": ["id", "title", "status", "zone", "risk", "created"],
  "additionalProperties": false,
  "properties": {
    "id":       { "$ref": "event.schema.json#/$defs/caseId" },
    "type":     { "const": "case", "description": "frontmatter only (SPEC-LOGBOOK §3); omitted in the index" },
    "title":    { "type": "string", "minLength": 1 },
    "status":   { "enum": ["queued", "active", "verification", "completed", "dropped"] },
    "zone":     { "enum": ["green", "yellow", "red"] },
    "risk":     { "enum": ["R0", "R1", "R2", "R3"] },
    "priority": { "enum": ["high", "normal", "low"], "default": "normal" },
    "area":     { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "created":  { "type": "string", "format": "date" },
    "started":  { "type": ["string", "null"], "format": "date" },
    "closed":   { "type": ["string", "null"], "format": "date" },
    "snapshotBefore": { "type": ["integer", "null"], "minimum": 0 },
    "agents":   { "type": "array", "items": { "type": "string", "pattern": "^agent:[a-z0-9-]+$" } },
    "events":   { "type": "array", "items": { "$ref": "event.schema.json#/$defs/ulid" }, "description": "ids of non-seldon ledger events attributed to this case (directly or via a linked resolution), oldest first" },
    "tags":     { "type": "array", "items": { "type": "string" } },
    "path":     { "type": "string", "description": "index only: relative to logbook root" },
    "steps":    { "type": "object", "required": ["total", "done"], "additionalProperties": false,
                  "properties": { "total": { "type": "integer", "minimum": 0 }, "done": { "type": "integer", "minimum": 0 } },
                  "description": "index only: checkboxes in the case's ## Plan section" },
    "proposedEvents": { "type": "array", "items": { "$ref": "event.schema.json#/$defs/ulid" }, "description": "index only: open drift events the engine thinks belong here" }
  }
}
